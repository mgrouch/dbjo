<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>dbjo-root</artifactId>
        <groupId>org.github.dbjo</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>dbjo-sim-model</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.github.dbjo</groupId>
            <artifactId>dbjo-meta</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.github.dbjo</groupId>
            <artifactId>dbjo-rdb</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.github.dbjo</groupId>
            <artifactId>dbjo-sim-db</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>

            <!-- 1) Start HSQLDB before codegen -->
            <plugin>
                <groupId>org.github.dbjo</groupId>
                <artifactId>dbjo-hsql-plugin</artifactId>
                <version>${project.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.github.dbjo</groupId>
                        <artifactId>dbjo-sim-db</artifactId>
                        <version>${project.parent.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>hsqldb-start</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <dbName>dbjo</dbName>
                            <dbPath>mem:dbjo</dbPath>
                            <port>9001</port>
                            <user>SA</user>
                            <pass></pass>

                            <!-- IMPORTANT: do NOT block the Maven build -->
                            <block>false</block>

                            <!-- Optional: init schema before codegen uses metadata -->
                            <!-- Use classpath or file path. If your schema.sql is in src/main/resources, classpath works. -->
                            <initScript>classpath:schema.sql</initScript>

                            <!-- Optional: wait for server readiness -->
                            <waitMs>15000</waitMs>
                        </configuration>
                    </execution>

                    <!-- 3) Stop HSQLDB after codegen -->
                    <execution>
                        <id>hsqldb-stop</id>
                        <!-- process-sources happens after generate-sources -->
                        <phase>process-sources</phase>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                        <configuration>
                            <dbName>dbjo</dbName>
                            <port>9001</port>
                            <user>SA</user>
                            <pass></pass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2) Codegen plugin -->
            <plugin>
                <groupId>org.github.dbjo</groupId>
                <artifactId>dbjo-codegen-plugin</artifactId>
                <version>${project.version}</version>

                <!-- JDBC driver on plugin classpath -->
                <dependencies>
                    <dependency>
                        <groupId>org.hsqldb</groupId>
                        <artifactId>hsqldb</artifactId>
                        <version>2.7.3</version>
                    </dependency>
                </dependencies>

                <executions>
                    <execution>
                        <id>dbjo-generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>

                        <configuration>
                            <protobufJavaVersion>${protobuf.version}</protobufJavaVersion>

                            <downloadProtoc>true</downloadProtoc>
                            <protocInstallDir>${project.build.directory}/tools/protoc</protocInstallDir>

                            <run>all</run>

                            <driver>org.hsqldb.jdbc.JDBCDriver</driver>
                            <url>jdbc:hsqldb:hsql://localhost:9001/dbjo</url>
                            <user>SA</user>
                            <pass></pass>

                            <overwrite>true</overwrite>

                            <codegenOutJava>${project.build.directory}/generated-sources/dbjo</codegenOutJava>
                            <protoOutJava>${project.build.directory}/generated-sources/dbjo</protoOutJava>

                            <addCompileRoots>true</addCompileRoots>

                            <args>
                                <arg>--beanPkg=org.github.dbjo.generated.model.entity</arg>
                                <arg>--protoJavaPkg=org.github.dbjo.generated.model.proto</arg>
                                <arg>--protoMapperPkg=org.github.dbjo.generated.model.protomap</arg>
                                <arg>--daoPkg=org.github.dbjo.generated.model.rdb.dao</arg>
                                <arg>--schemaPkg=org.github.dbjo.generated.model.rdb.schema</arg>
                                <arg>--dbMetaPkg=org.github.dbjo.generated.model.dbmeta</arg>
                                <arg>--queryPkg=org.github.dbjo.generated.model.query</arg>
                                <arg>--querySuffix=Q</arg>
                                <arg>--registryPkg=org.github.dbjo.sim.model.generated.meta.registry</arg>
                                <arg>--registryClass=BizDataMetaRegistry</arg>
                                <arg>--enumEnabled=true</arg>
                                <arg>--enumPkg=org.github.dbjo.generated.model.enum</arg>
                                <arg>--enumIncludeViews=false</arg>
                                <arg>--enumOrderBySortOrderIfPresent=true</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <properties>
        <protobuf.version>3.25.3</protobuf.version>
        <protoc.version>3.25.3</protoc.version>
        <protoc.bin>protoc</protoc.bin>
    </properties>
</project>