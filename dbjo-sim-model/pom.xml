<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>dbjo-root</artifactId>
        <groupId>org.github.dbjo</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>dbjo-sim-model</artifactId>
    <build>
        <plugins>
            <plugin>
                <groupId>org.github.dbjo</groupId>
                <artifactId>dbjo-codegen-plugin</artifactId>
                <!-- IMPORTANT: use the same version as in the reactor -->
                <version>${project.version}</version>

                <!-- Put the JDBC driver here so the plugin can load it -->
                <dependencies>
                    <dependency>
                        <groupId>org.hsqldb</groupId>
                        <artifactId>hsqldb</artifactId>
                        <version>2.7.3</version>
                    </dependency>
                </dependencies>

                <executions>
                    <execution>
                        <id>dbjo-generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>

                        <configuration>
                            <!-- generator mode -->
                            <run>all</run>

                            <!-- JDBC -->
                            <driver>org.hsqldb.jdbc.JDBCDriver</driver>
                            <url>jdbc:hsqldb:hsql://localhost:9001/dbjo</url>
                            <user>SA</user>
                            <pass></pass>

                            <!-- overwrite existing generated files -->
                            <overwrite>true</overwrite>

                            <!-- output roots -->
                            <codegenOutJava>${project.build.directory}/generated-sources/dbjo</codegenOutJava>
                            <protoOutJava>${project.build.directory}/generated-sources/dbjo-proto-java</protoOutJava>

                            <!-- add generated directories to compile roots -->
                            <addCompileRoots>true</addCompileRoots>

                            <!-- passthrough args to your generator -->
                            <args>
                                <!-- adapt to YOUR packages -->
                                <arg>--beanPkg=org.github.dbjo.sim.model.generated.entity</arg>
                                <arg>--protoJavaPkg=org.github.dbjo.sim.model.generated.proto</arg>
                                <arg>--protoMapperPkg=org.github.dbjo.sim.model.generated.protomap</arg>

                                <arg>--daoPkg=org.github.dbjo.sim.model.generated.dao</arg>
                                <arg>--schemaPkg=org.github.dbjo.sim.model</arg>

                                <arg>--dbMetaPkg=org.github.dbjo.sim.model.generated.dbmeta</arg>

                                <!-- optional filters -->
                                <!-- <arg>- -schemaInclude=PUBLIC</arg> -->
                                <!-- <arg>- -tableInclude=USER.*</arg> -->
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>